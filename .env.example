# Default: local SQLite file (created on first use). For PostgreSQL install the
# `postgres` extra and use e.g. postgresql+psycopg://eval:eval@localhost:5432/agent_eval
DATABASE_URL=sqlite:///./data/agent_eval.db

# Only needed for agents registered with adapter="claude" (install the `claude` extra).
# The Anthropic SDK also resolves credentials from an `ant auth login` profile.
ANTHROPIC_API_KEY=

# HTTP is denied unless this operator-owned credential/tenant configuration exists.
# See docs/deployment.md; keep the real file outside version control.
# AGENT_EVAL_AUTH_FILE=./data/http-auth.json

# Telemetry is disabled unless explicitly configured. Install the observability extra.
# OTEL_TRACES_EXPORTER=console
# OTEL_SERVICE_NAME=agent-eval-redteam
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4318
